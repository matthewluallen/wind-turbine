{
  // Build recipe for the base image used by every Codespace in this repo.
  // It is built and published by .github/workflows/images.yml -- students
  // never build this; their devcontainer.json files just reference the image.
  "name": "wind-turbine-base",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // lets `gh codespace ssh` / `gh codespace logs` work for troubleshooting
    "ghcr.io/devcontainers/features/sshd:1": {}
  }
}
