{
  "name": "wtg-9",
  "image": "ghcr.io/matthewluallen/wind-turbine/devcontainer:v1",

  "containerEnv": {
    "HOSTNAME": "wtg-9"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },

        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "portsAttributes": {
    "1880": {
      "label": "Turbine HMI"
    },
    "3000": {
      "label": "Turbine Ground Truth"
    },
    "8080": {
      "label": "Wireshark"
    },
    "8090": {
      "label": "Adversary"
    }
  },

  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postStartCommand": "docker compose up -d"
}
