# Grafana with the OpenSearch data source plugin baked in, so a Codespace
# never has to download the plugin from grafana.com at creation time.
ARG GRAFANA_VERSION=13.0.2

FROM debian:bookworm-slim AS plugin
ARG OPENSEARCH_PLUGIN_VERSION=2.13.0
RUN apt update \
  && apt install -y --no-install-recommends ca-certificates curl unzip \
  && curl -fL -o /tmp/opensearch.zip "https://grafana.com/api/plugins/grafana-opensearch-datasource/versions/${OPENSEARCH_PLUGIN_VERSION}/download?os=linux&arch=amd64" \
  && mkdir -p /plugins \
  && unzip -q -d /plugins /tmp/opensearch.zip

FROM grafana/grafana-oss:${GRAFANA_VERSION}
ENV GF_PATHS_PLUGINS=/opt/grafana-plugins
COPY --from=plugin /plugins /opt/grafana-plugins
